{
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/\\#F4A259/i]",
        "message": "Use canon accent #F7A835 (brand canon) instead of #F4A259"
      },
      {
        "selector": "Literal[value=/\\#ff9d23/i]",
        "message": "Use canon accent #F7A835 (or var(--accent)) instead of legacy #ff9d23"
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.tsx", "*.ts"],
      "rules": {
        "@typescript-eslint/naming-convention": [
          "warn",
          {
            "selector": "variable",
            "modifiers": ["const"],
            "format": ["camelCase", "UPPER_CASE", "PascalCase"],
            "custom": {
              "regex": "^ACCENT$",
              "match": false
            }
          }
        ]
      }
    }
  ]
}
